# ── Kopiraj u .env i popuni pravim vrednostima ──────────────────────────

# Resend API kljuc (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresa sa koje se salju mejlovi (mora biti na verifikovanom domenu u Resend-u)
# npr. "Lumora <porudzbine@lumora.rs>"
ORDER_FROM="Lumora <porudzbine@example.com>"

# Adresa (ili vise njih, odvojene zarezom) na koju TI dobijas porudzbine
# Ako se ne postavi, koristi se SITE.email iz src/data/site.ts (homedecorlumora@gmail.com)
ORDER_TO=homedecorlumora@gmail.com

# Puni URL sajta (bez / na kraju) – koristi se u mejlovima i SEO-u
PUBLIC_SITE_URL=https://www.lumora.rs

# Adresa admin aplikacije (link u mejlu "Otvori u aplikaciji"). Ako se ne postavi: <PUBLIC_SITE_URL>/admin/
# ADMIN_URL=https://www.lumora.rs/admin/

# Statistika posete sajta (opciono, besplatno, bez kolacica) — popuni JEDNO od dva:
# Cloudflare Web Analytics (token iz Cloudflare -> Web Analytics):
# PUBLIC_CF_BEACON=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Umami Cloud (Website ID):
# PUBLIC_UMAMI_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
