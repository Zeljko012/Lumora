---
// Baner "Novo u ponudi" na vrhu početne strane. Prikazuje do dva najnovija proizvoda iz src/data/novo.json.
import { NOVO_SORTED } from "../data/novo";
import { money } from "../lib/format";
import { withBase } from "../lib/url";

const items = NOVO_SORTED.slice(0, 2);
---

{
  items.length > 0 && (
    <section class="novo container" aria-label="Novo u ponudi">
      <div class="novo__head">
        <span class="novo__tag">Novo u ponudi</span>
        <a class="novo__all" href={withBase("/novo")}>Sve novo →</a>
      </div>
      <div class={`novo__grid novo__grid--${items.length}`}>
        {items.map((p, i) => (
          <a class="novo__card" href={withBase(`/proizvod/${p.slug}`)}>
            <div class="novo__img">
              <img
                src={withBase(p.images[0].src)}
                alt={p.images[0].alt}
                width="864"
                height="864"
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
              />
              <span class="novo__badge">Novo</span>
            </div>
            <div class="novo__body">
              <h2>{p.name}</h2>
              <p>{p.lead}</p>
              <span class="novo__meta">
                <span class="novo__price">{money(p.price)}</span>
                <span class="novo__go">Pogledaj →</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .novo {
    padding-top: clamp(1rem, 3vw, 1.75rem);
  }
  .novo__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .novo__tag {
    font: 500 0.72rem/1 var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--clay);
  }
  .novo__all {
    font-size: 0.85rem;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .novo__all:hover {
    color: var(--accent);
  }
  .novo__grid {
    display: grid;
    gap: 1rem;
  }
  .novo__grid--2 {
    grid-template-columns: repeat(2, 1fr);
  }
  .novo__card {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: stretch;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .novo__grid--1 .novo__card {
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
  }
  .novo__grid--1 .novo__body {
    padding-inline: clamp(1.25rem, 5vw, 4rem);
  }
  .novo__card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }
  .novo__img {
    position: relative;
    aspect-ratio: 1;
    background: var(--surface-tint);
  }
  .novo__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .novo__badge {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    background: var(--clay);
    color: #fff;
    font: 600 0.68rem/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
  }
  .novo__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
    padding: clamp(1rem, 3vw, 1.75rem);
    min-width: 0;
  }
  .novo__body h2 {
    font-size: var(--step-2);
    line-height: 1.12;
    margin: 0;
  }
  .novo__body p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .novo__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }
  .novo__price {
    font-weight: 600;
  }
  .novo__go {
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .novo__grid--2 {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .novo__card,
    .novo__grid--1 .novo__card {
      grid-template-columns: 1fr;
    }
    .novo__img {
      aspect-ratio: 4 / 3;
    }
    .novo__body {
      text-align: center;
      align-items: center;
    }
    .novo__meta {
      justify-content: center;
      gap: 1rem;
    }
  }
</style>
