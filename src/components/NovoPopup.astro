---
// Iskačući prozor "Novo u ponudi": pojavi se 3 sekunde po ulasku na sajt, jednom po poseti, i lako se zatvara.
// Prikazuje najnoviji proizvod iz src/data/novo.json. Za probu dodaj ?novo=1 na adresu (prikaže se i ako je već viđen).
import { NOVO_SORTED } from "../data/novo";
import { money } from "../lib/format";
import { withBase } from "../lib/url";

const p = NOVO_SORTED[0];
---

{
  p && (
    <div class="novo-pop" data-novo-pop data-slug={p.slug} hidden>
      <div class="novo-pop__backdrop" data-novo-close />
      <div class="novo-pop__card" role="dialog" aria-modal="true" aria-label="Novo u ponudi">
        <button type="button" class="novo-pop__x" data-novo-close aria-label="Zatvori">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19" />
          </svg>
        </button>
        <a class="novo-pop__img" href={withBase(`/proizvod/${p.slug}`)}>
          <img src={withBase(p.images[0].src)} data-src={withBase(p.images[0].src)} alt={p.images[0].alt} width="864" height="864" loading="lazy" decoding="async" />
          <span class="novo-pop__badge">Novo u ponudi</span>
        </a>
        <div class="novo-pop__body">
          <h2>{p.name}</h2>
          <p>{p.lead}</p>
          <div class="novo-pop__price">{p.options ? "od " : ""}{money(p.price)}</div>
          <a class="btn novo-pop__cta" href={withBase(`/proizvod/${p.slug}`)}>
            Pogledaj
          </a>
          <button type="button" class="novo-pop__later" data-novo-close>
            Nastavi razgledanje
          </button>
        </div>
      </div>
    </div>
  )
}

<style>
  .novo-pop {
    position: fixed;
    inset: 0;
    z-index: 110;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .novo-pop[hidden] {
    display: none;
  }
  .novo-pop__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(20 14 10 / 45%);
    animation: novo-fade 0.25s ease both;
  }
  .novo-pop__card {
    position: relative;
    width: min(100%, 24rem);
    max-height: calc(100dvh - 2rem);
    overflow: auto;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg, 22px);
    box-shadow: 0 18px 60px rgb(0 0 0 / 30%);
    animation: novo-rise 0.3s ease both;
  }
  .novo-pop__x {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 2;
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 88%);
    color: #2a2420;
    cursor: pointer;
    box-shadow: 0 1px 6px rgb(0 0 0 / 18%);
  }
  .novo-pop__x:hover {
    background: #fff;
  }
  .novo-pop__img {
    position: relative;
    display: block;
    aspect-ratio: 1;
    background: var(--surface-tint);
  }
  .novo-pop__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .novo-pop__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--clay);
    color: #fff;
    font: 600 0.68rem/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
  }
  .novo-pop__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    padding: 1.1rem 1.25rem 1.1rem;
  }
  .novo-pop__body h2 {
    font-size: var(--step-2);
    line-height: 1.12;
    margin: 0;
  }
  .novo-pop__body p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .novo-pop__price {
    font-weight: 600;
  }
  .novo-pop__cta {
    margin-top: 0.25rem;
    min-width: 11rem;
  }
  .novo-pop__later {
    border: 0;
    background: none;
    color: var(--ink-soft);
    font: inherit;
    font-size: 0.85rem;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .novo-pop__later:hover {
    color: var(--accent);
  }

  /* telefon: manji prozor uz donju ivicu, da ne zaklanja ceo ekran */
  @media (max-width: 560px) {
    .novo-pop {
      align-items: flex-end;
      padding: 0.6rem;
    }
    .novo-pop__card {
      width: 100%;
      max-height: calc(100dvh - 1.2rem);
    }
    .novo-pop__img {
      aspect-ratio: 16 / 10;
    }
    .novo-pop__body {
      padding: 0.9rem 1rem 0.8rem;
      gap: 0.4rem;
    }
    .novo-pop__body p {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .novo-pop__cta {
      width: 100%;
    }
  }

  @keyframes novo-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes novo-rise {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .novo-pop__backdrop,
    .novo-pop__card {
      animation: none;
    }
  }
</style>

<script>
  const pop = document.querySelector<HTMLElement>("[data-novo-pop]");
  if (pop) {
    const slug = pop.dataset.slug || "";
    const path = location.pathname;
    const force = new URLSearchParams(location.search).has("novo");
    let seen = "";
    try {
      seen = sessionStorage.getItem("lumora.novoPop") || "";
    } catch {
      /* bez sessionStorage-a prikaži bar jednom po stranici */
    }
    // ne smeta pri porudžbini, na stranici istog proizvoda ni ako je već viđen u ovoj poseti
    const skip = /\/(kasa|korpa|hvala)(\/|$)/.test(path) || path.includes(`/proizvod/${slug}`);
    if (force || (!skip && seen !== slug)) {
      const close = () => {
        pop.hidden = true;
        document.removeEventListener("keydown", onKey);
      };
      const onKey = (e: KeyboardEvent) => {
        if (e.key === "Escape") close();
      };
      const img = pop.querySelector<HTMLImageElement>("img[data-src]");
      // slika se učita unapred, da se prozor ne pojavi prazan
      window.setTimeout(() => {
        if (img?.dataset.src) new Image().src = img.dataset.src;
      }, 1200);
      window.setTimeout(() => {
        pop.hidden = false;
        try {
          sessionStorage.setItem("lumora.novoPop", slug);
        } catch {
          /* nije važno */
        }
        document.addEventListener("keydown", onKey);
        pop.querySelector<HTMLElement>(".novo-pop__x")?.focus({ preventScroll: true });
      }, 3000);
      pop.querySelectorAll("[data-novo-close]").forEach((el) => el.addEventListener("click", close));
    }
  }
</script>
