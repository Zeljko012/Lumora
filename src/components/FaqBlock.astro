---
import type { Faq } from "../data/seo";

interface Props {
  faqs: Faq[];
  heading?: string;
}
const { faqs, heading = "Česta pitanja" } = Astro.props;

const ld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<section class="faq-block" aria-labelledby="faq-h">
  <h2 id="faq-h">{heading}</h2>
  <div class="faq-list">
    {
      faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(ld)} is:inline />

<style>
  .faq-block {
    max-width: 760px;
  }
  .faq-block h2 {
    font-size: var(--step-2);
    margin-bottom: 1rem;
  }
  .faq-list {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    padding: 0.95rem 0;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    color: var(--ink-soft);
    flex: 0 0 auto;
  }
  details[open] summary::after {
    content: "–";
  }
  details p {
    padding-bottom: 1rem;
    color: var(--ink-soft);
    max-width: 62ch;
  }
</style>
