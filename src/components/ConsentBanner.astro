---
import { withBase } from "../lib/url";
---

<div class="consent" data-consent role="dialog" aria-label="Kolačići" hidden>
  <p>
    Sajt koristi kolačiće za merenje posete i oglasa. <a href={withBase("/politika-privatnosti")}>Više</a>
  </p>
  <div class="consent__btns">
    <button type="button" class="btn btn--ghost" data-consent-no>Odbijam</button>
    <button type="button" class="btn" data-consent-yes>Prihvatam</button>
  </div>
</div>

<style>
  .consent {
    position: fixed;
    left: 0.75rem;
    bottom: 0.75rem;
    right: 0.75rem;
    z-index: 90;
    max-width: 21rem;
    display: flex;
    gap: 0.6rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.6rem 0.5rem 0.85rem;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: 0 4px 18px rgb(0 0 0 / 10%);
    font-size: 0.8rem;
  }
  .consent[hidden] {
    display: none;
  }
  .consent p {
    margin: 0;
    line-height: 1.3;
  }
  .consent a {
    color: var(--accent);
    white-space: nowrap;
  }
  .consent__btns {
    display: flex;
    gap: 0.35rem;
    flex-shrink: 0;
  }
  @media (max-width: 560px) {
    .consent {
      max-width: none;
      flex-direction: column;
      justify-content: center;
      text-align: center;
      gap: 0.5rem;
      padding: 0.7rem 0.85rem;
      border-radius: 16px;
    }
    .consent__btns {
      justify-content: center;
    }
  }
  .consent__btns .btn {
    padding: 0.35rem 0.8rem;
    font-size: 0.78rem;
    min-height: 0;
    line-height: 1.2;
  }
</style>

<script>
  import { getConsent, setConsent, measuringBlocked } from "../lib/pixel";

  const box = document.querySelector<HTMLElement>("[data-consent]");
  const show = () => {
    if (box && !measuringBlocked()) box.hidden = false;
  };
  const hide = () => {
    if (box) box.hidden = true;
  };

  if (getConsent() === null) show();

  document.querySelector("[data-consent-yes]")?.addEventListener("click", () => {
    setConsent("granted");
    hide();
  });
  document.querySelector("[data-consent-no]")?.addEventListener("click", () => {
    setConsent("denied");
    hide();
  });
  // "Podešavanje kolačića" u podnožju
  document.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("[data-consent-open]")) {
      setConsent(null);
      show();
    }
  });
</script>
