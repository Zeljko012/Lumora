---
import { withBase } from "../lib/url";
---

<div class="consent" data-consent role="dialog" aria-label="Kolačići" hidden>
  <p>
    Koristimo kolačiće za merenje posete i oglasa (Meta Pixel). Sajt radi isto i ako ih odbiješ.
    <a href={withBase("/politika-privatnosti")}>Više o tome</a>
  </p>
  <div class="consent__btns">
    <button type="button" class="btn btn--ghost" data-consent-no>Odbijam</button>
    <button type="button" class="btn" data-consent-yes>Prihvatam</button>
  </div>
</div>

<style>
  .consent {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 90;
    max-width: 34rem;
    margin-inline: auto;
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    padding: 1rem 1.15rem;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg, 16px);
    box-shadow: 0 10px 40px rgb(0 0 0 / 18%);
    font-size: 0.92rem;
  }
  .consent[hidden] {
    display: none;
  }
  .consent p {
    margin: 0;
    flex: 1 1 14rem;
    line-height: 1.45;
  }
  .consent a {
    color: var(--accent);
  }
  .consent__btns {
    display: flex;
    gap: 0.6rem;
    margin-left: auto;
  }
</style>

<script>
  import { getConsent, setConsent, measuringBlocked } from "../lib/pixel";

  const box = document.querySelector<HTMLElement>("[data-consent]");
  const show = () => {
    if (box && !measuringBlocked()) box.hidden = false;
  };
  const hide = () => {
    if (box) box.hidden = true;
  };

  if (getConsent() === null) show();

  document.querySelector("[data-consent-yes]")?.addEventListener("click", () => {
    setConsent("granted");
    hide();
  });
  document.querySelector("[data-consent-no]")?.addEventListener("click", () => {
    setConsent("denied");
    hide();
  });
  // "Podešavanje kolačića" u podnožju
  document.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("[data-consent-open]")) {
      setConsent(null);
      show();
    }
  });
</script>
