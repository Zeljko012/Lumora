---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.astro";
import { SITE } from "../data/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "product" | "article";
  noindex?: boolean;
  /** dodatni JSON-LD objekti */
  jsonLd?: object[];
}

const {
  title,
  description,
  image,
  type = "website",
  noindex = false,
  jsonLd = [],
} = Astro.props;

const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: SITE.url,
  email: SITE.email,
  logo: new URL("/icon.svg", SITE.url).href,
  sameAs: [SITE.social.instagram],
  address: {
    "@type": "PostalAddress",
    addressLocality: SITE.address.city,
    addressCountry: SITE.address.countryCode,
  },
  areaServed: "RS",
};

const allLd = [orgLd, ...jsonLd];
---

<!doctype html>
<html lang="sr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ece5d8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#211c18" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap"
    />

    <Seo title={title} description={description} image={image} type={type} noindex={noindex} />

    <script is:inline>
      // Spreči treptaj teme pre učitavanja CSS-a
      try {
        var t = localStorage.getItem("lumora.theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    </script>

    {
      allLd.map((obj) => (
        <script type="application/ld+json" set:html={JSON.stringify(obj)} />
      ))
    }
  </head>
  <body>
    <a href="#main" class="skip-link">Preskoči na sadržaj</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <div class="toast-wrap" data-toast-wrap aria-live="polite"></div>

    <script>
      // Globalni toast helper
      window.addEventListener("lumora:toast", (e) => {
        const msg = (e as CustomEvent<string>).detail;
        const wrap = document.querySelector("[data-toast-wrap]");
        if (!wrap) return;
        const el = document.createElement("div");
        el.className = "toast";
        el.textContent = msg;
        wrap.appendChild(el);
        setTimeout(() => el.remove(), 2600);
      });
    </script>
  </body>
</html>
