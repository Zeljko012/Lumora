---
import ProductLanding from "../../components/ProductLanding.astro";
import { PRODUCTS, getProduct, type Product } from "../../data/products";
import { GIFT_PAGES, getGiftPage } from "../../data/seo";

export function getStaticPaths() {
  return GIFT_PAGES.map((g) => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params as { slug: string };
const g = getGiftPage(slug)!;

let items: Product[] = [];
if (g.products) {
  items = g.products.map((s) => getProduct(s)).filter((p): p is Product => !!p);
} else if (g.maxPrice) {
  items = PRODUCTS.filter((p) => p.price <= g.maxPrice!).sort(
    (a, b) => a.price - b.price || a.name.localeCompare(b.name, "sr"),
  );
}

const also = [
  ...GIFT_PAGES.filter((x) => x.slug !== g.slug).map((o) => ({
    label: o.h1,
    href: `/pokloni/${o.slug}`,
  })),
  { label: "Dekoracija za dnevnu sobu", href: "/dekoracija/dekoracija-za-dnevnu-sobu" },
  { label: "Moderne vaze", href: "/kategorija/vaze" },
  { label: "Dekorativne figure", href: "/kategorija/figure" },
  { label: "Svećnjaci", href: "/kategorija/svecnjaci" },
];
---

<ProductLanding
  page={g}
  items={items}
  section="pokloni"
  hubLabel="Pokloni"
  alsoTitle="Još ideja za poklon"
  also={also}
/>
