---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import { SITE } from "../data/site";
import {
  bestsellers,
  featuredProducts,
  productsByCategory,
  CATEGORY_META,
  type Category,
} from "../data/products";
import { money } from "../lib/format";

const best = bestsellers();
const featured = featuredProducts().slice(0, 2);
const heroImg = "/images/products/donut-vaza/1-lg.webp";

const cats: Category[] = ["vaze", "figure", "svecnjaci", "dom"];
const catCounts = Object.fromEntries(
  cats.map((c) => [c, productsByCategory(c).length]),
) as Record<Category, number>;

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  inLanguage: "sr-RS",
};
---

<Base
  title={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.description}
  jsonLd={[websiteLd]}
>
  <section class="hero container">
    <div class="hero__copy">
      <span class="eyebrow">Štampano u 3D-u · dovršeno ručno · Srbija</span>
      <h1>Skulpturalne dekoracije koje menjaju sobu, ne samo policu.</h1>
      <p class="hero__lead">
        Vaze, figure i svećnjaci crtani digitalno, štampani iz eko PLA materijala i
        dovršeni rukom — svaki komad zasebno, u 7 boja.
      </p>
      <div class="hero__cta">
        <a href="/prodavnica" class="btn btn--lg">Pogledaj sve proizvode</a>
        <a href="/o-nama" class="btn btn--ghost btn--lg">Kako nastaju</a>
      </div>
      <ul class="hero__trust">
        <li>Izrada u Srbiji</li>
        <li>Eko PLA</li>
        <li>Poklon pakovanje besplatno</li>
        <li>Dostava {SITE.deliveryTime}</li>
      </ul>
    </div>
    <div class="hero__art">
      <img
        src={heroImg}
        alt="Donut Vaza — 3D štampana dekoracija kružnog oblika, Lumora"
        width="900"
        height="1125"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <h2>Najtraženije</h2>
      <a href="/prodavnica">Cela ponuda →</a>
    </div>
    <div class="product-grid">
      {best.map((p, i) => <ProductCard product={p} eager={i < 4} />)}
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <h2>Kolekcije</h2>
      <span class="eyebrow">4 kategorije</span>
    </div>
    <nav class="bands" aria-label="Kolekcije">
      {
        cats.map((c, i) => (
          <a class="band" href={`/kategorija/${c}`}>
            <span class="band__i">0{i + 1}</span>
            <span class="band__n">{CATEGORY_META[c].title}</span>
            <span class="band__c">{catCounts[c]} {catCounts[c] === 1 ? "komad" : "komada"}</span>
          </a>
        ))
      }
    </nav>
  </section>

  <section class="section container">
    <div class="section-head">
      <h2>Izdvajamo</h2>
      <span class="eyebrow">{money(SITE.freeShippingThreshold)}+ = besplatna dostava</span>
    </div>
    <div class="feature">
      {
        featured.map((p) => (
          <a class="feature__card" href={`/proizvod/${p.slug}`}>
            <div class="feature__img">
              <img src={p.images[0].src} alt={p.images[0].alt} width="800" height="800" loading="lazy" />
            </div>
            <div class="feature__body">
              <h3>{p.name}</h3>
              <p>{p.lead}</p>
              <span class="price">{money(p.price)}</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section container">
    <div class="story">
      <blockquote>
        „Svaki komad počinje kao 3D model, a završava se rukom — brušenjem, čišćenjem
        ivica i proverom boje pod dnevnim svetlom.”
      </blockquote>
      <div class="story__stats">
        <div><b>≈ 48 h</b><span>štampe po komadu</span></div>
        <div><b>Eko PLA</b><span>biljni, biorazgradiv polimer</span></div>
        <div><b>7 boja</b><span>ista forma, tvoj izbor tona</span></div>
      </div>
    </div>
  </section>

  <section class="section container newsletter">
    <div>
      <h2>Ostanite u toku</h2>
      <p>Nove forme i sezonske boje javljamo prvi put ovde. Bez spama.</p>
    </div>
    <form data-newsletter novalidate>
      <label class="visually-hidden" for="nl-email">Email adresa</label>
      <input id="nl-email" type="email" name="email" placeholder="vas@email.rs" autocomplete="email" required />
      <input type="text" name="company" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />
      <button class="btn" type="submit">Prijava</button>
    </form>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding-block: clamp(2rem, 6vw, 4.5rem);
  }
  .hero__copy h1 {
    font-size: var(--step-4);
    line-height: 1.04;
    margin: 1rem 0 0;
  }
  .hero__lead {
    max-width: 46ch;
    color: var(--ink-soft);
    font-size: var(--step-1);
    margin-top: 1.1rem;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }
  .hero__trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0;
    margin: 1.6rem 0 0;
    font: 500 0.74rem/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }
  .hero__trust li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hero__trust li + li::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--line-strong);
  }
  .hero__art {
    border-radius: 200px 200px var(--radius-lg) var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface-tint);
  }
  .hero__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }
  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero__art {
      order: -1;
      border-radius: 120px 120px var(--radius) var(--radius);
      max-height: 60vh;
    }
  }

  /* category bands */
  .bands {
    display: flex;
    flex-direction: column;
  }
  .band {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 1.2rem;
    padding: 1.25rem 0.8rem;
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    transition:
      background-color 0.25s ease,
      transform 0.25s ease;
  }
  .band:last-child {
    border-bottom: 1px solid var(--line);
  }
  .band__i,
  .band__c {
    font: 500 0.78rem/1 var(--font-mono);
    color: var(--ink-soft);
  }
  .band__n {
    font-family: var(--font-display);
    font-size: var(--step-5);
  }
  .band:hover {
    background: var(--surface);
    transform: translateX(10px);
  }
  .band:hover .band__n {
    color: var(--accent);
  }

  /* feature */
  .feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 3vw, 2rem);
  }
  .feature__card {
    text-decoration: none;
    color: inherit;
  }
  .feature__img {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface-tint);
  }
  .feature__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .feature__card:hover .feature__img img {
    transform: scale(1.03);
  }
  .feature__body {
    padding-top: 0.9rem;
  }
  .feature__body h3 {
    font-size: var(--step-2);
  }
  .feature__body p {
    color: var(--ink-soft);
    margin: 0.35rem 0 0.6rem;
    max-width: 44ch;
    font-size: 0.95rem;
  }
  @media (max-width: 700px) {
    .feature {
      grid-template-columns: 1fr;
    }
  }

  /* story */
  .story {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .story blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.35;
  }
  .story__stats {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .story__stats div {
    border-left: 2px solid var(--clay);
    padding-left: 0.9rem;
  }
  .story__stats b {
    display: block;
    font: 500 1.05rem/1.2 var(--font-mono);
  }
  .story__stats span {
    color: var(--ink-soft);
    font-size: 0.88rem;
  }
  @media (max-width: 700px) {
    .story {
      grid-template-columns: 1fr;
    }
  }

  /* newsletter */
  .newsletter {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .newsletter h2 {
    font-size: var(--step-2);
  }
  .newsletter p {
    color: var(--ink-soft);
    margin-top: 0.3rem;
    max-width: 40ch;
  }
  .newsletter form {
    display: flex;
    gap: 0.5rem;
    flex: 1;
    min-width: 260px;
    max-width: 420px;
  }
  .newsletter input[type="email"] {
    flex: 1;
    padding: 0.8rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--ground);
    color: var(--ink);
    font: inherit;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-newsletter]");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (data.get("company")) return; // honeypot
    const email = String(data.get("email") || "");
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      window.dispatchEvent(
        new CustomEvent("lumora:toast", { detail: "Unesite ispravnu email adresu." }),
      );
      return;
    }
    try {
      localStorage.setItem("lumora.newsletter", email);
    } catch {}
    form.innerHTML = "<p style='color:var(--accent);font-weight:600'>Hvala! Javićemo se sa novostima.</p>";
  });
</script>
