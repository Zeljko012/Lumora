---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../data/site";
import { money } from "../lib/format";

const faqs = [
  {
    q: "Kako se plaća?",
    a: `Isključivo pouzećem — gotovinom kuriru pri preuzimanju. Nema online plaćanja karticom.`,
  },
  {
    q: "Koliko traje dostava?",
    a: `${SITE.deliveryTime} od potvrde porudžbine, kurirskom službom po celoj Srbiji.`,
  },
  {
    q: "Kolika je poštarina?",
    a: `Besplatna je za porudžbine preko ${money(SITE.freeShippingThreshold)}. Za manje porudžbine dostava se naplaćuje po ceni kurirske službe, plaća se kuriru zajedno sa porudžbinom.`,
  },
  {
    q: "Od čega su proizvodi napravljeni?",
    a: `Od eko PLA materijala — biljnog, biorazgradivog polimera. Otporan je na svakodnevno korišćenje i bezbedan za dom.`,
  },
  {
    q: "Da li vaze drže vodu?",
    a: `Ne. Vaze su namenjene suvom cveću i pampas travi. Nisu vodootporne.`,
  },
  {
    q: "Kako se održavaju?",
    a: `Suvom ili blago vlažnom krpom. Izbegavajte direktno sunce i izvore toplote.`,
  },
  {
    q: "U kojim bojama radite?",
    a: `U 7 boja: bela, bež, siva, crna, roze, maslinasto zelena i crvena. Boju birate na stranici proizvoda.`,
  },
  {
    q: "Mogu li da vratim proizvod?",
    a: `Da, u roku od 14 dana od prijema, nekorišćen i u originalnom pakovanju. Detalji na strani Dostava i povraćaj.`,
  },
  {
    q: "Da li izrađujete komade po meri?",
    a: `Za posebne zahteve (dimenzije, boje, veće količine za poslovne poklone) pišite nam na ${SITE.email}.`,
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Base
  title="Česta pitanja"
  description="Odgovori na najčešća pitanja o plaćanju, dostavi, materijalu, održavanju i povraćaju — Lumora."
  jsonLd={[faqLd]}
>
  <div class="container">
    <Breadcrumbs items={[{ label: "Česta pitanja" }]} />
    <div class="faq">
      <h1>Česta pitanja</h1>
      <div class="faq__list">
        {
          faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
      <p class="faq__more">
        Nema odgovora na vaše pitanje? Pišite na
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </div>
</Base>

<style>
  .faq {
    max-width: 720px;
    padding-block: 0.5rem 2.5rem;
  }
  .faq h1 {
    font-size: var(--step-3);
    margin-bottom: 1.5rem;
  }
  .faq__list {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    padding: 1rem 0;
    cursor: pointer;
    font-weight: 600;
    font-size: 1rem;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    color: var(--ink-soft);
    flex: 0 0 auto;
  }
  details[open] summary::after {
    content: "–";
  }
  details p {
    padding-bottom: 1rem;
    color: var(--ink-soft);
    max-width: 62ch;
  }
  .faq__more {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .faq__more a {
    color: var(--accent);
  }
</style>
