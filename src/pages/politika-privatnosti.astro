---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../data/site";
const updated = "2026";
---

<Base
  title="Politika privatnosti"
  description="Kako Lumora prikuplja i koristi lične podatke."
  noindex
>
  <div class="container">
    <Breadcrumbs items={[{ label: "Politika privatnosti" }]} />
    <article class="prose">
      <h1>Politika privatnosti</h1>
      <p><em>Poslednje ažuriranje: {updated}.</em></p>

      <div class="todo">
        ⚠️ Šablon — dopuni nazivom pravnog lica i, ako je primenljivo, podacima o licu
        za zaštitu podataka. Uskladi sa Zakonom o zaštiti podataka o ličnosti RS.
      </div>

      <h2>Koje podatke prikupljamo</h2>
      <ul>
        <li>Podatke iz porudžbine: ime i prezime, telefon, email, adresa za dostavu, napomena.</li>
        <li>Email adresu ako se prijavite na newsletter.</li>
        <li>
          Osnovne tehničke podatke o poseti (anonimna statistika), ako je uključena
          analitika.
        </li>
      </ul>

      <h2>Zašto ih koristimo</h2>
      <ul>
        <li>Za obradu i isporuku porudžbine i komunikaciju u vezi sa njom.</li>
        <li>Za slanje potvrde porudžbine i, uz vašu saglasnost, novosti.</li>
        <li>Za ispunjavanje zakonskih obaveza (npr. reklamacije, računovodstvo).</li>
      </ul>

      <h2>Kome ih prosleđujemo</h2>
      <p>
        Samo onima koji su neophodni za realizaciju porudžbine: kurirskoj službi (podaci
        za dostavu) i pružaocu usluge slanja email-a (Resend). Ne prodajemo i ne
        ustupamo podatke trećim licima u marketinške svrhe.
      </p>

      <h2>Koliko dugo ih čuvamo</h2>
      <p>
        Podatke o porudžbinama čuvamo koliko nalažu zakonski rokovi; email za newsletter
        do momenta odjave.
      </p>

      <h2>Vaša prava</h2>
      <p>
        Imate pravo na uvid, ispravku, brisanje i prigovor na obradu svojih podataka.
        Zahtev pošaljite na <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>

      <h2>Kolačići</h2>
      <p>
        Sajt koristi tehnički neophodne kolačiće (npr. čuvanje sadržaja korpe u vašem
        pregledaču). Analitički kolačići se koriste samo uz saglasnost.
      </p>

      <h2>Kontakt</h2>
      <p>{SITE.legalName} · {SITE.address.city}, {SITE.address.country} · {SITE.email}</p>
    </article>
  </div>
</Base>

<style>
  .prose {
    padding-block: 0.5rem 2rem;
  }
  .prose h1 {
    font-size: var(--step-3);
  }
  .todo {
    background: color-mix(in srgb, var(--clay) 15%, transparent);
    border: 1px solid var(--clay);
    border-radius: 10px;
    padding: 0.8rem 1rem;
    font-size: 0.85rem;
  }
</style>
