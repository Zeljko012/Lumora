---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FaqBlock from "../../components/FaqBlock.astro";
import { SITE } from "../../data/site";
import {
  CATEGORY_META,
  productsByCategory,
  type Category,
} from "../../data/products";
import { CATEGORY_SEO, fill } from "../../data/seo";
import { money } from "../../lib/format";
import { withBase } from "../../lib/url";

export function getStaticPaths() {
  return (["vaze", "figure", "svecnjaci", "dom"] as Category[]).map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params as { slug: Category };
const meta = CATEGORY_META[slug];
const seo = CATEGORY_SEO[slug];
const items = productsByCategory(slug);

const prices = items.map((p) => p.price);
const vars = {
  count: items.length,
  from: money(Math.min(...prices)),
  to: money(Math.max(...prices)),
};

const otherCats = (["vaze", "figure", "svecnjaci", "dom"] as Category[]).filter(
  (c) => c !== slug,
);

const ld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: seo.h1,
  url: new URL(`/kategorija/${slug}`, SITE.url).href,
  inLanguage: "sr-RS",
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: items.length,
    itemListElement: items.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: new URL(`/proizvod/${p.slug}`, SITE.url).href,
      name: p.name,
    })),
  },
};
---

<Base title={seo.title} description={fill(seo.description, vars)} jsonLd={[ld]}>
  <div class="container">
    <Breadcrumbs items={[{ label: "Prodavnica", href: "/prodavnica" }, { label: meta.title }]} />
    <header class="listing-head">
      <h1>{seo.h1}</h1>
      <p>{meta.intro}</p>
      <nav class="chips" aria-label="Kategorije">
        <a href={withBase("/prodavnica")}>Sve</a>
        <a href={withBase(`/kategorija/${slug}`)} aria-current="page">{meta.title}</a>
        {otherCats.map((c) => <a href={withBase(`/kategorija/${c}`)}>{CATEGORY_META[c].title}</a>)}
      </nav>
    </header>

    <div class="section">
      <div class="product-grid">
        {items.map((p, i) => <ProductCard product={p} eager={i < 4} />)}
      </div>
    </div>

    <section class="seo-copy">
      {
        seo.sections.map((s) => (
          <div class="seo-copy__block">
            <h2>{s.h2}</h2>
            {s.p.map((t) => <p>{t}</p>)}
          </div>
        ))
      }
    </section>

    <div class="faq-wrap">
      <FaqBlock faqs={seo.faqs.map((f) => ({ q: fill(f.q, vars), a: fill(f.a, vars) }))} />
    </div>

    <nav class="also" aria-label="Pogledaj i">
      <h2>Pogledaj i</h2>
      <ul>
        {seo.related.map((l) => <li><a href={withBase(l.href)}>{l.label}</a></li>)}
        {otherCats.map((c) => <li><a href={withBase(`/kategorija/${c}`)}>{CATEGORY_META[c].heading}</a></li>)}
      </ul>
    </nav>
  </div>
</Base>

<style>
  .listing-head {
    padding-block: 0.5rem 1.5rem;
  }
  .listing-head h1 {
    font-size: var(--step-3);
  }
  .listing-head p {
    color: var(--ink-soft);
    margin-top: 0.5rem;
    max-width: 62ch;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  .chips a {
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }
  .chips a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .chips a[aria-current="page"] {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  .seo-copy {
    display: grid;
    gap: 2rem;
    max-width: 760px;
    padding-block: 1rem 2.5rem;
    border-top: 1px solid var(--line);
    margin-top: 1rem;
    padding-top: 2.5rem;
  }
  .seo-copy h2 {
    font-size: var(--step-2);
    margin-bottom: 0.6rem;
  }
  .seo-copy p {
    color: var(--ink-soft);
  }
  .seo-copy p + p {
    margin-top: 0.8rem;
  }
  .faq-wrap {
    padding-bottom: 2.5rem;
  }
  .also {
    padding-block: 0 2rem;
  }
  .also h2 {
    font-size: var(--step-1);
    margin-bottom: 0.8rem;
  }
  .also ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .also a {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .also a:hover {
    text-decoration: underline;
  }
</style>
